    "@element-plus/icons-vue": "^2.3.2",
    "@google/genai": "^1.46.0",
    "@neondatabase/serverless": "^1.1.0",
    "@types/md5": "^2.3.6",
    "@vercel/kv": "^2.0.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "axios": "^1.13.5",
