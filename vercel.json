{
  "rewrites": [
    {
      "source": "/adminapi/:path*",
      "destination": "/api/proxy/:path*"
    },
    {
      "source": "/api/ai-chat",
      "destination": "/api/ai-chat"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/ai-chat.ts": {
      "maxDuration": 60
    },
    "api/proxy/[...path].ts": {
      "maxDuration": 30
    }
  }
}
